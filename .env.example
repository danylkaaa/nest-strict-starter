# PostgreSQL settings, read by compose.yaml and by the backend, migration, and seed tooling. Set a local password before starting Compose.
POSTGRES_USER=app
POSTGRES_PASSWORD=12345678
# Host-published port; containers override it with 5432.
POSTGRES_PORT=5433
# Optional; defaults to localhost. Containers override it with the postgres service name.
# POSTGRES_HOST=localhost
# Created by docker/postgres/01-create-database.sh on first volume initialization.
DATABASE_NAME=nest_starter

# Backend settings.
NODE_ENV=development
http__port=3000
logger__level=info
