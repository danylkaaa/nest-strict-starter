# Docker PostgreSQL credentials, read by compose.yaml. Set a local password before starting Compose.
POSTGRES_USER=app
POSTGRES_PASSWORD=12345678
POSTGRES_PORT=5433
# Created by docker/postgres/01-create-database.sh on first volume initialization.
DATABASE_NAME=nest_starter

# Filled by pnpm run setup from the PostgreSQL values above.
DATABASE_URL=

# Backend settings.
NODE_ENV=development
http__port=3000
logger__level=info
