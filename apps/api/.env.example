# development | test | production. development = pretty-printed logs, otherwise JSON
NODE_ENV=development
PORT=3000
# Optional: trace | debug | info | warn | error | fatal | silent
# Overrides the NODE_ENV default (production=info, test=warn, development=debug)
# LOG_LEVEL=debug
# Required: secret used to sign access tokens (min 32 chars, no default; the app will not start until you set it)
JWT_SECRET=
# Access token lifetime in seconds (default 3600 = 1h)
# JWT_EXPIRES_IN=3600
