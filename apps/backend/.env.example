# development | test | production. development = pretty-printed logs, otherwise JSON
NODE_ENV=development
http__port=3000
# Optional: trace | debug | info | warn | error | fatal | silent
# Overrides the NODE_ENV default (production=info, test=warn, development=debug)
# logger__level=debug
# Use the same PostgreSQL URL as DATABASE_URL in packages/database/.env.
postgres__url=postgresql://app:CHANGE_ME@localhost:5433/nest_starter

# Bounds connection acquisition and query execution separately (milliseconds, default 3000).
# postgres__timeout_ms=3000
# postgres__pool__max=5
# postgres__pool__min=1
