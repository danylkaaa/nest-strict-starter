{
  "name": "backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "concurrently -k -n api,worker1,worker2 \"pnpm run dev:api\" \"pnpm run worker:dev\" \"pnpm run worker:dev\"",
    "dev:api": "nest start --watch --entryFile api/main",
    "start": "node dist/api/main.js",
    "worker:dev": "wait-on dist/worker/main.js && node --watch --watch-path=dist dist/worker/main.js",
    "worker:start": "node dist/worker/main.js",
    "queue:migrate": "node scripts/migrate-queue.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts"
  },
  "dependencies": {
    "@nestjs-cls/transactional": "^4.0.1",
    "@nestjs-cls/transactional-adapter-drizzle-orm": "^2.0.1",
    "@nestjs/common": "^12.1.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.1",
    "@nestjs/drizzle": "^0.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.1.1",
    "@nestjs/swagger": "^12.0.2",
    "@workspace/database": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "flat": "^6.0.1",
    "nestjs-cls": "^7.0.1",
    "nestjs-pino": "^5.2.1",
    "nestjs-zod": "^5.5.0",
    "neverthrow": "^8.2.0",
    "pg": "^8.23.0",
    "pg-boss": "^12.35.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@golevelup/ts-vitest": "^4.0.0",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.1.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.12",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.5",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "typescript": "^6.0.3",
    "unplugin-swc": "^2.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.2",
    "wait-on": "^9.5.1"
  }
}
