      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Link: jobs.id = pgboss.job.id (same UUID).  jobs = what the user sees (status, payload, result, history).\npgboss.job = what workers consume (state, start_after, retry_count). If the enqueue fails, nothing is saved.",
      "originalText": "Link: jobs.id = pgboss.job.id (same UUID).  jobs = what the user sees (status, payload, result, history).\npgboss.job = what workers consume (state, start_after, retry_count). If the enqueue fails, nothing is saved.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
